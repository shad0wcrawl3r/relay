
package main

import (
	"context"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"net/url"
	"strings"
	"sync"
	"time"

	"github.com/danielgtaylor/huma/v2"
	"github.com/danielgtaylor/huma/v2/adapters/humagin"
	"github.com/gin-gonic/gin"
	"github.com/spf13/viper"
)

const planeAPI = "https://api.plane.so"

type HealthOutput struct {
	Body struct {
		Status string `json:"status"`
		App    string `json:"app"`
	}
}

type Config struct {
	AppName string
	Port    int
	Plane   PlaneConfig
}

type PlaneConfig struct {
	ClientID      string
	ClientSecret  string
	RedirectURI   string
	WorkspaceSlug string
	Scope         string
}

type TokenResponse struct {
	AccessToken string `json:"access_token"`
	TokenType   string `json:"token_type"`
	ExpiresIn   int    `json:"expires_in"`
	Scope       string `json:"scope"`
}

type Installation struct {
	ID        string `json:"id"`
	Workspace string `json:"workspace"`
	Status    string `json:"status"`

	WorkspaceDetail struct {
		Name string `json:"name"`
		Slug string `json:"slug"`
	} `json:"workspace_detail"`
}

type InstalledApp struct {
	InstallationID string
	WorkspaceID    string
	WorkspaceSlug  string
	BotToken       string
	ExpiresAt      time.Time
}

var (
	installations   = make(map[string]InstalledApp)
	installationsMu sync.RWMutex

	httpClient = &http.Client{
		Timeout: 20 * time.Second,
	}
)

func main() {
	cfg, err := LoadConfig()
	if err != nil {
		log.Fatal(err)
	}

	router := gin.Default()

	api := humagin.New(
		router,
		huma.DefaultConfig(cfg.AppName, "1.0.0"),
	)

	huma.Register(api, huma.Operation{
		OperationID: "health",
		Method:      http.MethodGet,
		Path:        "/api/health",
		Summary:     "Health check",
	}, func(
		ctx context.Context,
		input *struct{},
	) (*HealthOutput, error) {
		out := &HealthOutput{}
		out.Body.Status = "ok"
		out.Body.App = cfg.AppName
		return out, nil
	})

	// Start Plane's app installation flow.
	router.GET("/install", func(c *gin.Context) {
		params := url.Values{}
		params.Set("client_id", cfg.Plane.ClientID)
		params.Set("response_type", "code")
		params.Set("redirect_uri", cfg.Plane.RedirectURI)

		if cfg.Plane.Scope != "" {
			params.Set("scope", cfg.Plane.Scope)
		}

		target := planeAPI + "/auth/o/authorize-app/?" + params.Encode()
		c.Redirect(http.StatusFound, target)
	})

	// Receive the installation callback and obtain the bot token.
	router.GET("/callback", func(c *gin.Context) {
		installationID := strings.TrimSpace(
			c.Query("app_installation_id"),
		)

		if installationID == "" {
			c.JSON(http.StatusBadRequest, gin.H{
				"error": "missing app_installation_id",
			})
			return
		}

		token, err := exchangeBotToken(cfg.Plane, installationID)
		if err != nil {
			log.Printf("Plane token exchange failed: %v", err)
			c.JSON(http.StatusBadGateway, gin.H{
				"error": "Plane token exchange failed",
				"hint":  "Check app credentials, scopes, and server logs.",
			})
			return
		}

		installation, err := getInstallation(
			token.AccessToken,
			installationID,
		)
		if err != nil {
			log.Printf("Plane installation verification failed: %v", err)
			c.JSON(http.StatusBadGateway, gin.H{
				"error": "Plane installation verification failed",
			})
			return
		}

		workspaceID := installation.Workspace
		workspaceSlug := installation.WorkspaceDetail.Slug

		if workspaceID == "" || workspaceSlug == "" {
			c.JSON(http.StatusBadGateway, gin.H{
				"error": "Plane returned incomplete installation details",
				"installation": installation,
			})
			return
		}

		installed := InstalledApp{
			InstallationID: installationID,
			WorkspaceID:    workspaceID,
			WorkspaceSlug:  workspaceSlug,
			BotToken:       token.AccessToken,
		}

		if token.ExpiresIn > 0 {
			installed.ExpiresAt = time.Now().Add(
				time.Duration(token.ExpiresIn) * time.Second,
			)
		}

		installationsMu.Lock()
		installations[installationID] = installed
		installationsMu.Unlock()

		log.Printf(
			"Plane installation verified for workspace %q",
			workspaceSlug,
		)

		// Temporary local-testing response. Do not expose this publicly.
		c.JSON(http.StatusOK, gin.H{
			"status":              "installed",
			"app_installation_id": installationID,
			"workspace":           workspaceSlug,
			"workspace_id":         workspaceID,
			"bot_token":            token.AccessToken,
			"token_type":           token.TokenType,
			"expires_in":           token.ExpiresIn,
			"next":                 "/data?installation_id=" + url.QueryEscape(installationID),
		})
	})

	// Retrieve real projects and work items from Plane.
	router.GET("/data", func(c *gin.Context) {
		installationID := strings.TrimSpace(
			c.Query("installation_id"),
		)

		if installationID == "" {
			c.JSON(http.StatusBadRequest, gin.H{
				"error": "provide ?installation_id=YOUR_INSTALLATION_ID",
			})
			return
		}

		installationsMu.RLock()
		installed, ok := installations[installationID]
		installationsMu.RUnlock()

		if !ok {
			c.JSON(http.StatusNotFound, gin.H{
				"error": "installation not found; complete /install first",
			})
			return
		}

		workspace := url.PathEscape(installed.WorkspaceSlug)

		projectsURL := planeAPI +
			"/api/v2/workspaces/" + workspace + "/projects/"

		workItemsURL := planeAPI +
			"/api/v2/workspaces/" + workspace + "/work-items/"

		projects, projectStatus, projectErr := fetchPlaneJSON(
			projectsURL,
			installed.BotToken,
		)
		if projectErr != nil {
			log.Printf("Fetching Plane projects failed: %v", projectErr)
			c.JSON(http.StatusBadGateway, gin.H{
				"error":  "could not fetch projects",
				"status": projectStatus,
				"detail": projectErr.Error(),
			})
			return
		}

		workItems, itemsStatus, itemsErr := fetchPlaneJSON(
			workItemsURL,
			installed.BotToken,
		)
		if itemsErr != nil {
			log.Printf("Fetching Plane work items failed: %v", itemsErr)
			c.JSON(http.StatusBadGateway, gin.H{
				"error":    "could not fetch work items",
				"status":   itemsStatus,
				"detail":   itemsErr.Error(),
				"projects": projects,
			})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"workspace": installed.WorkspaceSlug,
			"installation": gin.H{
				"id":          installed.InstallationID,
				"workspace_id": installed.WorkspaceID,
			},
			"projects":   projects,
			"work_items": workItems,
		})
	})

	addr := fmt.Sprintf(":%d", cfg.Port)
	log.Printf("%s listening on http://localhost%s", cfg.AppName, addr)

	if err := router.Run(addr); err != nil {
		log.Fatal(err)
	}
}

func exchangeBotToken(
	cfg PlaneConfig,
	installationID string,
) (*TokenResponse, error) {
	form := url.Values{}
	form.Set("grant_type", "client_credentials")
	form.Set("app_installation_id", installationID)

	if cfg.Scope != "" {
		form.Set("scope", cfg.Scope)
	}

	req, err := http.NewRequest(
		http.MethodPost,
		planeAPI+"/auth/o/token/",
		strings.NewReader(form.Encode()),
	)
	if err != nil {
		return nil, err
	}

	credentials := cfg.ClientID + ":" + cfg.ClientSecret
	req.Header.Set(
		"Authorization",
		"Basic "+base64.StdEncoding.EncodeToString(
			[]byte(credentials),
		),
	)
	req.Header.Set(
		"Content-Type",
		"application/x-www-form-urlencoded",
	)
	req.Header.Set("Accept", "application/json")

	resp, err := httpClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
	if err != nil {
		return nil, err
	}

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, fmt.Errorf(
			"token endpoint returned HTTP %d: %s",
			resp.StatusCode,
			strings.TrimSpace(string(body)),
		)
	}

	var token TokenResponse
	if err := json.Unmarshal(body, &token); err != nil {
		return nil, fmt.Errorf("decode token response: %w", err)
	}

	if token.AccessToken == "" {
		return nil, fmt.Errorf("Plane returned an empty access token")
	}

	return &token, nil
}

func getInstallation(
	token string,
	installationID string,
) (*Installation, error) {
	u := planeAPI + "/auth/o/app-installation/?" +
		url.Values{
			"id": []string{installationID},
		}.Encode()

	req, err := http.NewRequest(http.MethodGet, u, nil)
	if err != nil {
		return nil, err
	}

	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Accept", "application/json")

	resp, err := httpClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
	if err != nil {
		return nil, err
	}

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, fmt.Errorf(
			"installation endpoint returned HTTP %d: %s",
			resp.StatusCode,
			strings.TrimSpace(string(body)),
		)
	}

	var results []Installation
	if err := json.Unmarshal(body, &results); err == nil {
		if len(results) == 0 {
			return nil, fmt.Errorf("Plane returned no installation records")
		}
		return &results[0], nil
	}

	// Also accept a single-object response, if returned by the API.
	var single Installation
	if err := json.Unmarshal(body, &single); err != nil {
		return nil, fmt.Errorf(
			"decode installation response: %w",
			err,
		)
	}
	if single.ID == "" {
		return nil, fmt.Errorf("Plane returned an empty installation record")
	}

	return &single, nil
}

// fetchPlaneJSON retrieves a JSON response from a Plane API endpoint.
func fetchPlaneJSON(
	endpoint string,
	token string,
) (any, int, error) {
	req, err := http.NewRequest(http.MethodGet, endpoint, nil)
	if err != nil {
		return nil, 0, err
	}

	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Accept", "application/json")

	resp, err := httpClient.Do(req)
	if err != nil {
		return nil, 0, err
	}
	defer resp.Body.Close()

	body, err := io.ReadAll(io.LimitReader(resp.Body, 10<<20))
	if err != nil {
		return nil, resp.StatusCode, err
	}

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, resp.StatusCode, fmt.Errorf(
			"Plane returned HTTP %d: %s",
			resp.StatusCode,
			strings.TrimSpace(string(body)),
		)
	}

	var result any
	if err := json.Unmarshal(body, &result); err != nil {
		return nil, resp.StatusCode, fmt.Errorf(
			"invalid JSON from Plane: %w",
			err,
		)
	}

	return result, resp.StatusCode, nil
}

func LoadConfig() (Config, error) {
	v := viper.New()

	v.SetConfigName("config")
	v.SetConfigType("toml")
	v.AddConfigPath(".")

	v.SetEnvPrefix("HOMELAB")
	v.SetEnvKeyReplacer(strings.NewReplacer(".", "_"))
	v.AutomaticEnv()

	v.SetDefault("app_name", "homelab")
	v.SetDefault("port", 8080)
	v.SetDefault("plane.scope", "read")

	if err := v.ReadInConfig(); err != nil {
		return Config{}, fmt.Errorf("read config.toml: %w", err)
	}

	cfg := Config{
		AppName: v.GetString("app_name"),
		Port:    v.GetInt("port"),
		Plane: PlaneConfig{
			ClientID:      v.GetString("plane.client_id"),
			ClientSecret:  v.GetString("plane.client_secret"),
			RedirectURI:   v.GetString("plane.redirect_uri"),
			WorkspaceSlug: v.GetString("plane.workspace_slug"),
			Scope:         v.GetString("plane.scope"),
		},
	}

	if cfg.AppName == "" {
		cfg.AppName = "homelab"
	}
	if cfg.Port < 1 || cfg.Port > 65535 {
		return Config{}, fmt.Errorf("port must be between 1 and 65535")
	}
	if cfg.Plane.ClientID == "" || cfg.Plane.ClientSecret == "" {
		return Config{}, fmt.Errorf(
			"plane.client_id and plane.client_secret are required",
		)
	}
	if cfg.Plane.RedirectURI == "" {
		return Config{}, fmt.Errorf("plane.redirect_uri is required")
	}

	return cfg, nil
}

