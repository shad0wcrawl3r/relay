<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="relay"
        Arguments=""
        InstallLocation="C:\Program Files\shadowcrawler\Relay">
    </Installer>
    <PackageInformation
        PackageName="Relay"
        PackageDisplayName="Relay"
        PublisherName="CN=shadowcrawler"
        PublisherDisplayName="shadowcrawler"
        Version="0.0.7.0"
        PackageDescription="Desktop workbench for Plane, Dev.to writing, Buffer and terminals">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.shadowcrawler.relay"
                Description="Desktop workbench for Plane, Dev.to writing, Buffer and terminals"
                DisplayName="Relay"
                ExecutableName="relay"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Relay</DisplayName>
            <PublisherDisplayName>shadowcrawler</PublisherDisplayName>
            <Description>Desktop workbench for Plane, Dev.to writing, Buffer and terminals</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="relay.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
